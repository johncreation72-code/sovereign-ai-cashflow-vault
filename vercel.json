{
  "version": 2,
  "cleanUrls": false,
  "crons": [
    {
      "path": "/api/cron_dispatch",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron_dispatch",
      "schedule": "0 13 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ]
}
